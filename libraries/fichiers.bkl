{
  "format": "berkios-library/1",
  "id": "fichiers",
  "version": "1.0.0",
  "title": "Fichiers et dossiers",
  "description": "Noms de fichiers sûrs, extensions et chemins, création de fichiers texte, et un espace de dossiers et fichiers interne à l'application (créer, lister, lire, écrire, renommer, copier, supprimer, exporter).",
  "author": "BERKIOS",
  "license": "MIT",
  "permissions": [
    "fichiers",
    "stockage"
  ],
  "commands": [
    {
      "id": "nom-fichier-sur",
      "names": [
        "nom-fichier-sur",
        "safe-filename"
      ],
      "usage": "nom-fichier-sur \"Nom\" \"Résultat\"",
      "summary": "Remplace par - les caractères interdits ou risqués dans un nom de fichier (\\ / : * ? \" < > | , ; ( ) & # % …). « sans-nom » si le nom devient vide.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsn\"",
        "nettoyer \"$fsn\"",
        "remplacer \"$fsn\" \"\\\\\" \"-\"",
        "remplacer \"$fsn\" \"/\" \"-\"",
        "remplacer \"$fsn\" \":\" \"-\"",
        "remplacer \"$fsn\" \"*\" \"-\"",
        "remplacer \"$fsn\" \"?\" \"-\"",
        "remplacer \"$fsn\" \"\\\"\" \"-\"",
        "remplacer \"$fsn\" \"<\" \"-\"",
        "remplacer \"$fsn\" \">\" \"-\"",
        "remplacer \"$fsn\" \"|\" \"-\"",
        "remplacer \"$fsn\" \"..\" \"-\"",
        "remplacer \"$fsn\" \",\" \"-\"",
        "remplacer \"$fsn\" \";\" \"-\"",
        "remplacer \"$fsn\" \"(\" \"-\"",
        "remplacer \"$fsn\" \")\" \"-\"",
        "remplacer \"$fsn\" \"'\" \"-\"",
        "remplacer \"$fsn\" \"&\" \"-\"",
        "remplacer \"$fsn\" \"#\" \"-\"",
        "remplacer \"$fsn\" \"%\" \"-\"",
        "remplacer \"$fsn\" \"@\" \"-\"",
        "remplacer \"$fsn\" \"!\" \"-\"",
        "remplacer \"$fsn\" \"+\" \"-\"",
        "remplacer \"$fsn\" \"=\" \"-\"",
        "remplacer \"$fsn\" \"[\" \"-\"",
        "remplacer \"$fsn\" \"]\" \"-\"",
        "remplacer \"$fsn\" \"{\" \"-\"",
        "remplacer \"$fsn\" \"}\" \"-\"",
        "remplacer \"$fsn\" \"$\" \"-\"",
        "remplacer \"$fsn\" \"^\" \"-\"",
        "remplacer \"$fsn\" \"~\" \"-\"",
        "remplacer \"$fsn\" \"`\" \"-\"",
        "par-defaut \"$fsn\" \"sans-nom\"",
        "copier \"$fsn\" %2"
      ]
    },
    {
      "id": "nom-fichier-valide",
      "names": [
        "nom-fichier-valide",
        "valid-filename"
      ],
      "usage": "nom-fichier-valide \"nom.ext\" \"Résultat\"",
      "summary": "true si le nom est accepté par la création de fichier (lettres, chiffres, espaces, _ - . ; 80 caractères ; une extension de 1 à 6 caractères).",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsn\"",
        "nettoyer \"$fsn\"",
        "correspond \"$fsn\" \"^(?!.*\\\\.\\\\.)[\\\\p{L}\\\\p{N}_. -]{1,80}\\\\.[A-Za-z0-9]{1,6}$\" %2"
      ]
    },
    {
      "id": "nom-fichier-horodate",
      "names": [
        "nom-fichier-horodate",
        "timestamped-filename"
      ],
      "usage": "nom-fichier-horodate \"base\" \"ext\" \"Résultat\"",
      "summary": "Construit base_AAAA-MM-JJ_HH-mm.ext (l'extension s'écrit sans point).",
      "minArgs": 3,
      "maxArgs": 3,
      "body": [
        "maintenant \"$fst\" \"AAAA-MM-JJ_HH-mm\"",
        "concatener %3 %1 \"_\" \"$fst\" \".\" %2"
      ]
    },
    {
      "id": "nom-fichier-numero",
      "names": [
        "nom-fichier-numero",
        "numbered-filename"
      ],
      "usage": "nom-fichier-numero \"base\" n \"ext\" \"Résultat\"",
      "summary": "Construit base-007.ext à partir d'un numéro (3 chiffres ; partie décimale ignorée).",
      "minArgs": 4,
      "maxArgs": 4,
      "body": [
        "copier %2 \"$fsnum\"",
        "entier \"$fsnum\"",
        "remplir-gauche \"$fsnum\" 3",
        "concatener %4 %1 \"-\" \"$fsnum\" \".\" %3"
      ]
    },
    {
      "id": "extension-fichier",
      "names": [
        "extension-fichier",
        "file-extension"
      ],
      "usage": "extension-fichier \"Nom\" \"Résultat\"",
      "summary": "Extension en minuscules, sans point (« jpg » pour Photo.JPG ; vide s'il n'y en a pas).",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsn\"",
        "nettoyer \"$fsn\"",
        "compter-texte \"$fsn\" \".\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsn\" \".\" \"$fsc1\" \"$fsx\"",
        "minuscules \"$fsx\"",
        "si \"$fsc\" = 0 alors set \"$fsx\" \"\"",
        "copier \"$fsx\" %2"
      ]
    },
    {
      "id": "changer-extension",
      "names": [
        "changer-extension",
        "change-extension"
      ],
      "usage": "changer-extension \"Nom\" \"ext\" \"Résultat\"",
      "summary": "Remplace la dernière extension (ou l'ajoute s'il n'y en a pas). L'extension s'écrit sans point.",
      "minArgs": 3,
      "maxArgs": 3,
      "body": [
        "copier %1 \"$fsn\"",
        "nettoyer \"$fsn\"",
        "compter-texte \"$fsn\" \".\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsn\" \".\" \"$fsc1\" \"$fsx\"",
        "longueur \"$fsn\" \"$fsl\"",
        "longueur \"$fsx\" \"$fsxl\"",
        "calculate \"$fsm\" \"$fsl\" - \"$fsxl\"",
        "calculate \"$fsm\" \"$fsm\" - \"$fsone\"",
        "si \"$fsc\" = 0 alors copier \"$fsl\" \"$fsm\"",
        "sous-texte \"$fsn\" 1 \"$fsm\" \"$fsstem\"",
        "concatener %3 \"$fsstem\" \".\" %2"
      ]
    },
    {
      "id": "chemin-joindre",
      "names": [
        "chemin-joindre",
        "path-join"
      ],
      "usage": "chemin-joindre \"Dossier\" \"Nom\" \"Résultat\"",
      "summary": "Assemble deux morceaux de chemin avec un seul / entre eux (\\ devient /, les // sont réduits).",
      "minArgs": 3,
      "maxArgs": 3,
      "body": [
        "copier %1 \"$fsa\"",
        "copier %2 \"$fsb\"",
        "nettoyer \"$fsa\"",
        "nettoyer \"$fsb\"",
        "remplacer \"$fsa\" \"\\\\\" \"/\"",
        "remplacer \"$fsb\" \"\\\\\" \"/\"",
        "concatener \"$fsj\" \"$fsa\" \"/\" \"$fsb\"",
        "remplacer \"$fsj\" \"//\" \"/\"",
        "remplacer \"$fsj\" \"//\" \"/\"",
        "remplacer \"$fsj\" \"//\" \"/\"",
        "remplacer \"$fsj\" \"//\" \"/\"",
        "si \"$fsa\" = \"\" alors copier \"$fsb\" \"$fsj\"",
        "si \"$fsb\" = \"\" alors copier \"$fsa\" \"$fsj\"",
        "copier \"$fsj\" %3"
      ]
    },
    {
      "id": "chemin-nom",
      "names": [
        "chemin-nom",
        "path-name"
      ],
      "usage": "chemin-nom \"Chemin\" \"Résultat\"",
      "summary": "Dernier élément d'un chemin (a/b/c.txt → c.txt). Le chemin ne doit pas finir par /.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" %2"
      ]
    },
    {
      "id": "chemin-dossier",
      "names": [
        "chemin-dossier",
        "path-folder"
      ],
      "usage": "chemin-dossier \"Chemin\" \"Résultat\"",
      "summary": "Chemin du dossier qui contient l'élément (a/b/c.txt → a/b ; vide à la racine). Le chemin ne doit pas finir par /.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" %2"
      ]
    },
    {
      "id": "fichier-creer",
      "names": [
        "fichier-creer",
        "create-file"
      ],
      "usage": "fichier-creer \"nom.ext\" \"Source\"",
      "summary": "Crée un fichier texte (.txt, .csv, .json…) avec la valeur de Source. Les caractères interdits du nom deviennent -, « .txt » est ajouté s'il n'y a pas d'extension. Le fichier est enregistré dans le dossier Téléchargements.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsn\"",
        "nettoyer \"$fsn\"",
        "remplacer \"$fsn\" \"\\\\\" \"-\"",
        "remplacer \"$fsn\" \"/\" \"-\"",
        "remplacer \"$fsn\" \":\" \"-\"",
        "remplacer \"$fsn\" \"*\" \"-\"",
        "remplacer \"$fsn\" \"?\" \"-\"",
        "remplacer \"$fsn\" \"\\\"\" \"-\"",
        "remplacer \"$fsn\" \"<\" \"-\"",
        "remplacer \"$fsn\" \">\" \"-\"",
        "remplacer \"$fsn\" \"|\" \"-\"",
        "remplacer \"$fsn\" \"..\" \"-\"",
        "par-defaut \"$fsn\" \"sans-nom\"",
        "compter-texte \"$fsn\" \".\" \"$fsdots\"",
        "si \"$fsdots\" = 0 alors concatener \"$fsn\" \"$fsn\" \".txt\"",
        "telecharger \"{$fsn}\" %2"
      ]
    },
    {
      "id": "fichier-creer-vide",
      "names": [
        "fichier-creer-vide",
        "create-empty-file"
      ],
      "usage": "fichier-creer-vide \"nom.ext\"",
      "summary": "Crée un fichier vide dans le dossier Téléchargements (mêmes règles de nom que fichier-creer).",
      "minArgs": 1,
      "maxArgs": 1,
      "body": [
        "copier %1 \"$fsn\"",
        "nettoyer \"$fsn\"",
        "remplacer \"$fsn\" \"\\\\\" \"-\"",
        "remplacer \"$fsn\" \"/\" \"-\"",
        "remplacer \"$fsn\" \":\" \"-\"",
        "remplacer \"$fsn\" \"*\" \"-\"",
        "remplacer \"$fsn\" \"?\" \"-\"",
        "remplacer \"$fsn\" \"\\\"\" \"-\"",
        "remplacer \"$fsn\" \"<\" \"-\"",
        "remplacer \"$fsn\" \">\" \"-\"",
        "remplacer \"$fsn\" \"|\" \"-\"",
        "remplacer \"$fsn\" \"..\" \"-\"",
        "par-defaut \"$fsn\" \"sans-nom\"",
        "compter-texte \"$fsn\" \".\" \"$fsdots\"",
        "si \"$fsdots\" = 0 alors concatener \"$fsn\" \"$fsn\" \".txt\"",
        "set \"$fsv\" \"\"",
        "telecharger \"{$fsn}\" \"$fsv\""
      ]
    },
    {
      "id": "fichier-creer-horodate",
      "names": [
        "fichier-creer-horodate",
        "create-timestamped-file"
      ],
      "usage": "fichier-creer-horodate \"base\" \"ext\" \"Source\"",
      "summary": "Crée base_AAAA-MM-JJ_HH-mm.ext avec la valeur de Source : chaque appel donne un nom nouveau (l'extension s'écrit sans point).",
      "minArgs": 3,
      "maxArgs": 3,
      "body": [
        "copier %1 \"$fsn\"",
        "nettoyer \"$fsn\"",
        "remplacer \"$fsn\" \"\\\\\" \"-\"",
        "remplacer \"$fsn\" \"/\" \"-\"",
        "remplacer \"$fsn\" \":\" \"-\"",
        "remplacer \"$fsn\" \"*\" \"-\"",
        "remplacer \"$fsn\" \"?\" \"-\"",
        "remplacer \"$fsn\" \"\\\"\" \"-\"",
        "remplacer \"$fsn\" \"<\" \"-\"",
        "remplacer \"$fsn\" \">\" \"-\"",
        "remplacer \"$fsn\" \"|\" \"-\"",
        "remplacer \"$fsn\" \"..\" \"-\"",
        "par-defaut \"$fsn\" \"sans-nom\"",
        "maintenant \"$fst\" \"AAAA-MM-JJ_HH-mm\"",
        "concatener \"$fsn\" \"$fsn\" \"_\" \"$fst\" \".\" %2",
        "telecharger \"{$fsn}\" %3"
      ]
    },
    {
      "id": "dossier-creer",
      "names": [
        "dossier-creer",
        "create-folder"
      ],
      "usage": "dossier-creer \"Chemin\"",
      "summary": "Crée un dossier dans l'espace de l'application. Le dossier parent doit exister (Rapports, puis Rapports/2026).",
      "minArgs": 1,
      "maxArgs": 1,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "set \"$fspk\" \"!d\"",
        "si \"$fsd\" != \"\" alors lire \"fs:e:{$fsdk}\" \"$fspk\" \"\"",
        "verifier \"$fspk\" = \"!d\" \"Le dossier parent n'existe pas.\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"\" \"Un fichier ou un dossier porte déjà ce nom.\"",
        "stocker \"fs:e:{$fsk}\" \"!d\"",
        "lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "liste-ajouter \"$fsi\" \"{$fsn}/\"",
        "stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "dossier-assurer",
      "names": [
        "dossier-assurer",
        "ensure-folder"
      ],
      "usage": "dossier-assurer \"Chemin\"",
      "summary": "Comme dossier-creer, mais sans erreur si le dossier existe déjà (utile à chaque démarrage). Le dossier parent doit exister ; refus si un fichier porte ce nom.",
      "minArgs": 1,
      "maxArgs": 1,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "set \"$fspk\" \"!d\"",
        "si \"$fsd\" != \"\" alors lire \"fs:e:{$fsdk}\" \"$fspk\" \"\"",
        "verifier \"$fspk\" = \"!d\" \"Le dossier parent n'existe pas.\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" != \"!f\" \"Un fichier porte déjà ce nom.\"",
        "stocker \"fs:e:{$fsk}\" \"!d\"",
        "concatener \"$fsname\" \"$fsn\" \"/\"",
        "si \"$fsx\" = \"\" alors lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "si \"$fsx\" = \"\" alors liste-ajouter \"$fsi\" \"{$fsname}\"",
        "si \"$fsx\" = \"\" alors stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "dossier-existe",
      "names": [
        "dossier-existe",
        "folder-exists"
      ],
      "usage": "dossier-existe \"Chemin\" \"Résultat\"",
      "summary": "true si le dossier existe dans l'espace de l'application (/ désigne la racine, qui existe toujours).",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "choisir %2 \"$fsx\" = \"!d\" \"true\" \"false\"",
        "si \"$fsok\" != \"true\" alors set %2 \"false\"",
        "si \"$fsp\" = \"/\" alors set %2 \"true\""
      ]
    },
    {
      "id": "dossier-lister",
      "names": [
        "dossier-lister",
        "list-folder"
      ],
      "usage": "dossier-lister \"Chemin\" \"Résultat\"",
      "summary": "Liste le contenu d'un dossier (/ pour la racine) : les sous-dossiers se terminent par /. Résultat sous forme de liste.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "si \"$fsp\" = \"/\" alors set \"$fsp\" \"\"",
        "set \"$fsok\" \"true\"",
        "si \"$fsp\" != \"\" alors correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "set \"$fsx\" \"!d\"",
        "si \"$fsp\" != \"\" alors lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"!d\" \"Dossier introuvable.\"",
        "lire \"fs:i:{$fsk}\" %2 \"\""
      ]
    },
    {
      "id": "dossier-supprimer",
      "names": [
        "dossier-supprimer",
        "delete-folder"
      ],
      "usage": "dossier-supprimer \"Chemin\"",
      "summary": "Supprime un dossier VIDE de l'espace de l'application (refus s'il contient quelque chose : supprimez d'abord son contenu).",
      "minArgs": 1,
      "maxArgs": 1,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"!d\" \"Dossier introuvable.\"",
        "lire \"fs:i:{$fsk}\" \"$fsi\" \"\"",
        "liste-taille \"$fsi\" \"$fsnb\"",
        "verifier \"$fsnb\" = 0 \"Le dossier n'est pas vide.\"",
        "oublier \"fs:e:{$fsk}\"",
        "oublier \"fs:i:{$fsk}\"",
        "lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "liste-retirer \"$fsi\" \"{$fsn}/\"",
        "stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "fichier-ecrire",
      "names": [
        "fichier-ecrire",
        "write-file"
      ],
      "usage": "fichier-ecrire \"Dossier/nom.txt\" \"Source\"",
      "summary": "Écrit (crée ou remplace) un fichier dans l'espace de l'application avec la valeur de Source. Le dossier doit exister.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "set \"$fspk\" \"!d\"",
        "si \"$fsd\" != \"\" alors lire \"fs:e:{$fsdk}\" \"$fspk\" \"\"",
        "verifier \"$fspk\" = \"!d\" \"Le dossier parent n'existe pas.\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" != \"!d\" \"Un dossier porte déjà ce nom.\"",
        "stocker \"fs:c:{$fsk}\" %2",
        "stocker \"fs:e:{$fsk}\" \"!f\"",
        "si \"$fsx\" = \"\" alors lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "si \"$fsx\" = \"\" alors liste-ajouter \"$fsi\" \"{$fsn}\"",
        "si \"$fsx\" = \"\" alors stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "fichier-ajouter",
      "names": [
        "fichier-ajouter",
        "append-file"
      ],
      "usage": "fichier-ajouter \"Dossier/journal.txt\" \"Texte\" [\"séparateur\"]",
      "summary": "Ajoute du texte à la fin d'un fichier de l'espace de l'application (le crée s'il n'existe pas ; le dossier doit exister). Le séparateur facultatif est inséré entre l'ancien contenu et le texte ajouté ; BERKIOS CODE ne sait pas écrire un saut de ligne dans un texte (utilisez par exemple \" | \" ou la valeur d'un champ multiligne).",
      "minArgs": 2,
      "maxArgs": 3,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "set \"$fspk\" \"!d\"",
        "si \"$fsd\" != \"\" alors lire \"fs:e:{$fsdk}\" \"$fspk\" \"\"",
        "verifier \"$fspk\" = \"!d\" \"Le dossier parent n'existe pas.\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" != \"!d\" \"Un dossier porte déjà ce nom.\"",
        "lire \"fs:c:{$fsk}\" \"$fsold\" \"\"",
        "si \"$fsold\" != \"\" alors concatener \"$fsold\" \"$fsold\" %3 %2",
        "si \"$fsold\" = \"\" alors copier %2 \"$fsold\"",
        "stocker \"fs:c:{$fsk}\" \"$fsold\"",
        "stocker \"fs:e:{$fsk}\" \"!f\"",
        "si \"$fsx\" = \"\" alors lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "si \"$fsx\" = \"\" alors liste-ajouter \"$fsi\" \"{$fsn}\"",
        "si \"$fsx\" = \"\" alors stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "fichier-lire",
      "names": [
        "fichier-lire",
        "read-file"
      ],
      "usage": "fichier-lire \"Dossier/nom.txt\" \"Résultat\"",
      "summary": "Lit le contenu d'un fichier de l'espace de l'application.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"!f\" \"Fichier introuvable.\"",
        "lire \"fs:c:{$fsk}\" %2 \"\""
      ]
    },
    {
      "id": "fichier-existe",
      "names": [
        "fichier-existe",
        "file-exists"
      ],
      "usage": "fichier-existe \"Dossier/nom.txt\" \"Résultat\"",
      "summary": "true si le fichier existe dans l'espace de l'application.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "choisir %2 \"$fsx\" = \"!f\" \"true\" \"false\"",
        "si \"$fsok\" != \"true\" alors set %2 \"false\""
      ]
    },
    {
      "id": "fichier-taille",
      "names": [
        "fichier-taille",
        "file-size"
      ],
      "usage": "fichier-taille \"Dossier/nom.txt\" \"Résultat\"",
      "summary": "Taille d'un fichier de l'espace de l'application, en caractères.",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"!f\" \"Fichier introuvable.\"",
        "lire \"fs:c:{$fsk}\" \"$fsv\" \"\"",
        "longueur \"$fsv\" %2"
      ]
    },
    {
      "id": "fichier-supprimer",
      "names": [
        "fichier-supprimer",
        "delete-file"
      ],
      "usage": "fichier-supprimer \"Dossier/nom.txt\"",
      "summary": "Supprime un fichier de l'espace de l'application.",
