        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"!f\" \"Fichier introuvable.\"",
        "oublier \"fs:c:{$fsk}\"",
        "oublier \"fs:e:{$fsk}\"",
        "lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "liste-retirer \"$fsi\" \"{$fsn}\"",
        "stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "fichier-supprimer-si-existe",
      "names": [
        "fichier-supprimer-si-existe",
        "delete-file-if-exists"
      ],
      "usage": "fichier-supprimer-si-existe \"Dossier/nom.txt\"",
      "summary": "Comme fichier-supprimer, mais sans erreur si le fichier n'existe pas (refus si le chemin désigne un dossier).",
      "minArgs": 1,
      "maxArgs": 1,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" != \"!d\" \"Ce chemin désigne un dossier, pas un fichier.\"",
        "si \"$fsx\" = \"!f\" alors oublier \"fs:c:{$fsk}\"",
        "si \"$fsx\" = \"!f\" alors oublier \"fs:e:{$fsk}\"",
        "si \"$fsx\" = \"!f\" alors lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "si \"$fsx\" = \"!f\" alors liste-retirer \"$fsi\" \"{$fsn}\"",
        "si \"$fsx\" = \"!f\" alors stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "fichier-renommer",
      "names": [
        "fichier-renommer",
        "rename-file"
      ],
      "usage": "fichier-renommer \"Dossier/ancien.txt\" \"nouveau.txt\"",
      "summary": "Renomme un fichier de l'espace de l'application, dans le même dossier (le nouveau nom ne contient pas de /).",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"!f\" \"Fichier introuvable.\"",
        "copier %2 \"$fsnew\"",
        "nettoyer \"$fsnew\"",
        "correspond \"$fsnew\" \"^(?! )(?!.* $)(?!.*\\\\.\\\\.)(?!\\\\.$)[\\\\p{L}\\\\p{N}_. -]{1,80}$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Nouveau nom invalide : lettres, chiffres, espaces et _ - . ; pas de /.\"",
        "copier \"$fsnew\" \"$fsnp\"",
        "si \"$fsd\" != \"\" alors concatener \"$fsnp\" \"$fsd\" \"/\" \"$fsnew\"",
        "copier \"$fsnp\" \"$fsnk\"",
        "minuscules \"$fsnk\"",
        "set \"$fsx\" \"\"",
        "si \"$fsnk\" != $fsk alors lire \"fs:e:{$fsnk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"\" \"Un fichier ou un dossier porte déjà ce nom.\"",
        "lire \"fs:c:{$fsk}\" \"$fsv\" \"\"",
        "oublier \"fs:c:{$fsk}\"",
        "oublier \"fs:e:{$fsk}\"",
        "stocker \"fs:c:{$fsnk}\" \"$fsv\"",
        "stocker \"fs:e:{$fsnk}\" \"!f\"",
        "lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "liste-retirer \"$fsi\" \"{$fsn}\"",
        "liste-ajouter \"$fsi\" \"{$fsnew}\"",
        "stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "fichier-copier",
      "names": [
        "fichier-copier",
        "copy-file"
      ],
      "usage": "fichier-copier \"Dossier/source.txt\" \"Dossier/copie.txt\"",
      "summary": "Copie un fichier de l'espace de l'application vers un autre emplacement (le dossier de destination doit exister ; refus si la destination existe déjà).",
      "minArgs": 2,
      "maxArgs": 2,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"!f\" \"Fichier introuvable.\"",
        "copier %2 \"$fsq\"",
        "nettoyer \"$fsq\"",
        "remplacer \"$fsq\" \"\\\\\" \"/\"",
        "correspond \"$fsq\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsq\" \"$fsqk\"",
        "minuscules \"$fsqk\"",
        "compter-texte \"$fsq\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsq\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsq\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsq\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "set \"$fspk\" \"!d\"",
        "si \"$fsd\" != \"\" alors lire \"fs:e:{$fsdk}\" \"$fspk\" \"\"",
        "verifier \"$fspk\" = \"!d\" \"Le dossier parent n'existe pas.\"",
        "lire \"fs:e:{$fsqk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"\" \"Un fichier ou un dossier porte déjà ce nom.\"",
        "lire \"fs:c:{$fsk}\" \"$fsv\" \"\"",
        "stocker \"fs:c:{$fsqk}\" \"$fsv\"",
        "stocker \"fs:e:{$fsqk}\" \"!f\"",
        "lire \"fs:i:{$fsdk}\" \"$fsi\" \"\"",
        "liste-ajouter \"$fsi\" \"{$fsn}\"",
        "stocker \"fs:i:{$fsdk}\" \"$fsi\""
      ]
    },
    {
      "id": "fichier-exporter",
      "names": [
        "fichier-exporter",
        "export-file"
      ],
      "usage": "fichier-exporter \"Dossier/nom.txt\"",
      "summary": "Écrit un vrai fichier dans le dossier Téléchargements à partir d'un fichier de l'espace de l'application (nom d'origine ; « .txt » ajouté s'il n'a pas d'extension).",
      "minArgs": 1,
      "maxArgs": 1,
      "body": [
        "copier %1 \"$fsp\"",
        "nettoyer \"$fsp\"",
        "remplacer \"$fsp\" \"\\\\\" \"/\"",
        "correspond \"$fsp\" \"^(?!/)(?! )(?!.* $)(?!.* /)(?!.*/ )(?!.*//)(?!.*\\\\.\\\\.)(?!.*(^|/)\\\\.(/|$))[\\\\p{L}\\\\p{N}_. /-]{1,200}(?<!/)$\" \"$fsok\"",
        "verifier \"$fsok\" = \"true\" \"Chemin invalide : lettres, chiffres, espaces et _ - . ; sous-dossiers séparés par /, sans / au début ni à la fin.\"",
        "copier \"$fsp\" \"$fsk\"",
        "minuscules \"$fsk\"",
        "compter-texte \"$fsp\" \"/\" \"$fsc\"",
        "set \"$fsone\" \"1\"",
        "calculate \"$fsc1\" \"$fsc\" + \"$fsone\"",
        "partie \"$fsp\" \"/\" \"$fsc1\" \"$fsn\"",
        "longueur \"$fsp\" \"$fsl\"",
        "longueur \"$fsn\" \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsl\" - \"$fsnl\"",
        "calculate \"$fsdl\" \"$fsdl\" - \"$fsone\"",
        "sous-texte \"$fsp\" 1 \"$fsdl\" \"$fsd\"",
        "copier \"$fsd\" \"$fsdk\"",
        "minuscules \"$fsdk\"",
        "lire \"fs:e:{$fsk}\" \"$fsx\" \"\"",
        "verifier \"$fsx\" = \"!f\" \"Fichier introuvable.\"",
        "lire \"fs:c:{$fsk}\" \"$fsv\" \"\"",
        "compter-texte \"$fsn\" \".\" \"$fsdots\"",
        "si \"$fsdots\" = 0 alors concatener \"$fsn\" \"$fsn\" \".txt\"",
        "telecharger \"{$fsn}\" \"$fsv\""
      ]
    }
  ]
}
